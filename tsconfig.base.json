{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "declaration": true,
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@cem-generator/core-utils": ["packages/core-utils/src/index.ts"],
      "@cem-generator/core": ["packages/core/src/index.ts"],
      "@cem-generator/plugin-lit": ["packages/plugins/lit/src/index.ts"]
    }
  }
}
