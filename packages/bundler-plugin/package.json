{
  "name": "@wc-toolkit/cem-generator-bundler",
  "version": "0.1.6",
  "description": "Vite, Rollup, Rolldown, and Webpack plugins for generating Custom Elements Manifests.",
  "keywords": [
    "custom-elements",
    "custom-elements-manifest",
    "vite",
    "web-components",
    "webpack"
  ],
  "homepage": "https://wc-toolkit.github.io/cem-generator/guide/bundler/",
  "bugs": {
    "url": "https://github.com/wc-toolkit/cem-generator/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wc-toolkit/cem-generator.git",
    "directory": "packages/bundler-plugin"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@wc-toolkit/cem-generator": "workspace:*"
  }
}
