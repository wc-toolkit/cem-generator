{
  "name": "@wc-toolkit/cem-generator-cli",
  "version": "0.1.2",
  "description": "CLI for generating Custom Elements Manifests.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wc-toolkit/cem-generator.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/wc-toolkit/cem-generator/issues"
  },
  "homepage": "https://wc-toolkit.github.io/cem-generator/guide/cli/",
  "keywords": [
    "custom-elements",
    "custom-elements-manifest",
    "web-components",
    "cli"
  ],
  "type": "module",
  "bin": {
    "cem": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/*.test.mjs",
    "dev": "tsx src/cli.ts",
    "demo": "node dist/cli.js generate --tsconfig ../../examples/tsconfig.json --output ../../examples/custom-elements-demo.json --conflict-policy last-wins"
  },
  "dependencies": {
    "@wc-toolkit/cem-generator": "workspace:*",
    "@wc-toolkit/cem-generator-utils": "workspace:*",
    "commander": "^12.1.0",
    "custom-elements-manifest": "^2.1.0",
    "inquirer": "^14.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.9.0"
  }
}
